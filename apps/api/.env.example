# ───────── Base de datos (PostgreSQL) ─────────
# Local con docker-compose:  postgresql://nido:nido@localhost:5432/nido
# Supabase (Transaction pooler, puerto 6543):  postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Neon:  postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/inmobiliaria"
# Proyecto Supabase (no reemplazan la contraseña de Postgres de arriba)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret (Settings → JWT Keys). Solo servidor; no es JWT_SECRET.
# SUPABASE_JWT_SECRET=
# Conexión DIRECTA (sin pooler); solo la usa `prisma migrate deploy`. Opcional.
# DIRECT_URL=
# Conexiones simultáneas por instancia (en Vercel/serverless usa 1–3)
DB_POOL_MAX=5

# ───────── Servidor ─────────
PORT=4000
NODE_ENV=development
# Mínimo 32 caracteres aleatorios:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres"
# Orígenes permitidos (CORS), separados por coma. En producción: https://tu-dominio.com
WEB_ORIGIN="http://localhost:3000"
# URL pública de la web (enlaces en correos). Por defecto, el primer WEB_ORIGIN
# WEB_PUBLIC_URL=
# 1 si el API está detrás de un proxy (Vercel, Render, Nginx…): el límite de peticiones usa X-Forwarded-For
TRUST_PROXY=1

# ───────── Almacenamiento de imágenes ─────────
# local = guarda en ./uploads (solo desarrollo). s3 = AWS S3, Cloudflare R2 o Supabase Storage (API S3)
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
# --- solo si STORAGE_DRIVER=s3 ---
# Cloudflare R2:  S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
# Supabase:       S3_ENDPOINT=https://<PROYECTO>.supabase.co/storage/v1/s3   S3_REGION=<región>  S3_FORCE_PATH_STYLE=true
# AWS S3:         (sin S3_ENDPOINT)  S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=nido-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# URL pública del bucket (dominio r2.dev / dominio propio / URL pública de Supabase), SIN barra final
# S3_PUBLIC_URL=https://media.tu-dominio.com
# S3_FORCE_PATH_STYLE=false

# ───────── Publicación y tareas ─────────
# true SOLO para demos. En producción déjalo en false: cada aviso lo aprueba un administrador.
# El rol ADMIN publica el suyo sin cola. Una cuenta verificada ya no se salta la revisión.
AUTO_APPROVE=false
# Nombre en correos
SITE_NAME=Jucaro
# Protege /cron/saved-searches. Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="cambia-esto"

# ───────── Correo ─────────
# El registro crea el usuario en Supabase Authentication si SUPABASE_URL, ANON y SERVICE_ROLE están definidos.
# El correo de confirmación lo envía el SMTP del proyecto (Authentication → Emails).
# Sin SMTP, configura Resend. Sin ninguno de los dos, en producción el alta responde emailSent: false.
# En Authentication → URL Configuration agrega {WEB_PUBLIC_URL}/confirmar-correo
# RESEND_API_KEY=
# MAIL_FROM="Jucaro <jucaroinmobiliaria@gmail.com>"

# ───────── Descripción con IA (opcional; sin esto se usa la plantilla incluida) ─────────
# AI_API_KEY=
# AI_MODEL=
