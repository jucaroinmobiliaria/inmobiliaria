# URL pública de la web (canonical, sitemap, Open Graph). En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nombre de la marca (opcional; por defecto «Jucaro»)
# NEXT_PUBLIC_SITE_NAME=Jucaro
# URL del API NestJS (solo servidor: proxy /backend/* y SSR). En producción: https://tu-api.vercel.app
API_URL=http://localhost:4000
# Estilo de mapa MapLibre (OpenFreeMap no necesita llave)
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
